DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Seed admin credentials (scripts/seed.ts). Dev defaults are used if unset:
# admin1@mdpva.org / ChangeMe@Admin1 and admin2@mdpva.org / ChangeMe@Admin2
SEED_ADMIN1_EMAIL="admin1@mdpva.org"
SEED_ADMIN1_PASSWORD="ChangeMe@Admin1"
SEED_ADMIN2_EMAIL="admin2@mdpva.org"
SEED_ADMIN2_PASSWORD="ChangeMe@Admin2"
