DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Seed admin credentials (scripts/seed.ts). Emails default to
# admin1@mdpva.org / admin2@mdpva.org if unset. Passwords have NO default —
# seeding fails loudly unless both are set explicitly, in every environment
# (including local dev). Pick strong, unique values; never commit real ones.
SEED_ADMIN1_EMAIL="admin1@mdpva.org"
SEED_ADMIN1_PASSWORD="<required, set locally, never commit>"
SEED_ADMIN2_EMAIL="admin2@mdpva.org"
SEED_ADMIN2_PASSWORD="<required, set locally, never commit>"

# Auth.js session encryption secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<required, generate locally, never commit>"

# Cloudflare R2 (member photos). Dashboard: R2 → Manage API Tokens → create
# an Account token, Object Read & Write, scoped to one bucket.
R2_ACCESS_KEY_ID="<required, never commit>"
R2_SECRET_ACCESS_KEY="<required, never commit>"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="mdpva"

# Cloudflare Turnstile (optional bot protection on /login and /onboard verify).
# Both unset = disabled, and both flows work normally.
# Removing only TURNSTILE_SECRET_KEY stops enforcement immediately with no
# redeploy — that is the intended kill switch. See README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
