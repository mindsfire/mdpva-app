DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Seed admin credentials (scripts/seed.ts). Emails default to
# admin1@mdpva.org / admin2@mdpva.org if unset. Passwords have NO default —
# seeding fails loudly unless both are set explicitly, in every environment
# (including local dev). Pick strong, unique values; never commit real ones.
SEED_ADMIN1_EMAIL="admin1@mdpva.org"
SEED_ADMIN1_PASSWORD="<required, set locally, never commit>"
SEED_ADMIN2_EMAIL="admin2@mdpva.org"
SEED_ADMIN2_PASSWORD="<required, set locally, never commit>"

# Auth.js session encryption secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<required, generate locally, never commit>"

# Object storage (member photos), S3-compatible. For local dev, run
# `docker compose up -d minio minio-init` and use these MinIO defaults —
# fully isolated from the real bucket, see README "Local dev object storage".
# For a deploy, point at the real Cloudflare R2 bucket instead: Dashboard →
# R2 → Manage API Tokens → create an Account token, Object Read & Write,
# scoped to one bucket.
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_ENDPOINT="http://localhost:9000"
R2_BUCKET="mdpva-dev"

# Aadhaar field-level encryption (src/lib/crypto/pii.ts). Two independent
# 32-byte keys, base64-encoded — one for AES-256-GCM encryption, one for the
# deterministic HMAC blind index used for the uniqueness check. Generate with:
#   openssl rand -base64 32
# Losing AADHAAR_ENC_KEY makes every stored Aadhaar number unrecoverable;
# rotating either key requires re-encrypting/re-hashing existing rows.
AADHAAR_ENC_KEY="<required, generate locally, never commit>"
AADHAAR_HASH_KEY="<required, generate locally, never commit>"

# Cloudflare Turnstile (optional bot protection on /login and /onboard verify).
# Both unset = disabled, and both flows work normally.
# Removing only TURNSTILE_SECRET_KEY stops enforcement immediately with no
# redeploy — that is the intended kill switch. See README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
